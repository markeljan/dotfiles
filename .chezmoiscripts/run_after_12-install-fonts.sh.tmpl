#!/usr/bin/env bash
set -euo pipefail
if [ "${DOTFILES_SKIP_PACKAGES:-0}" = 1 ]; then exit 0; fi
{{ if eq .chezmoi.os "darwin" -}}
font_dir="$HOME/Library/Fonts"
{{ else -}}
font_dir="$HOME/.local/share/fonts"
{{ end -}}
font_name=MartianMonoNerdFontMono-Regular.ttf
if [ -f "$font_dir/$font_name" ]; then exit 0; fi
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
curl -fLS --retry 3 {{ .fonts.martian.url | quote }} -o "$tmpdir/font.zip"
if command -v sha256sum >/dev/null 2>&1; then
  actual="$(sha256sum "$tmpdir/font.zip" | cut -d' ' -f1)"
else
  actual="$(shasum -a 256 "$tmpdir/font.zip" | cut -d' ' -f1)"
fi
test "$actual" = {{ .fonts.martian.sha256 | quote }}
mkdir -p "$font_dir"
unzip -o -j "$tmpdir/font.zip" 'MartianMonoNerdFontMono-Regular.ttf' 'MartianMonoNerdFontMono-Bold.ttf' 'MartianMonoNerdFontMono-Medium.ttf' -d "$font_dir"
if command -v fc-cache >/dev/null 2>&1; then fc-cache -f "$font_dir"; fi
