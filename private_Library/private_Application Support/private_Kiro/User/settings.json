{
    "telemetry.dataSharingAndPromptLogging.usageAnalyticsAndPerformanceMetrics": false,
    "telemetry.dataSharingAndPromptLogging.contentCollectionForServiceImprovement": false,

    // ——— Editor ergonomics ———
    "editor.wordWrap": "on",
    "editor.accessibilitySupport": "off",
    "editor.largeFileOptimizations": false,
    "editor.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 16,
    "debug.console.fontSize": 13,
    "editor.hover.delay": 500,
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.stickyScroll.enabled": false,
    "editor.inlineSuggest.enabled": true,
    "editor.inlineSuggest.edits.showCollapsed": true,

    // ——— Formatting ———
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.biome": "explicit",
        "source.organizeImports.biome": "explicit"
    },
    "[javascript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[tailwindcss]": {
        "editor.defaultFormatter": "biomejs.biome"
    },

    // ——— Workbench ———
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.pinnedTabsOnSeparateRow": true,
    "workbench.editor.wrapTabs": true,
    "workbench.tips.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.editor.restoreViewState": true,
    "workbench.editor.enablePreview": false,
    "workbench.tree.indent": 12,
    "workbench.editor.decorations.badges": false,
    // "workbench.preferredLightColorTheme": "Default Dark Modern",
    // "workbench.preferredDarkColorTheme": "Default Dark Modern",
    // "workbench.colorTheme": "Default Dark Modern",
    "workbench.view.showQuietly": {
        "workbench.panel.output": false
    },

    // ——— Explorer ———
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,

    // ——— Diff & search ———
    "diffEditor.wordWrap": "on",
    "diffEditor.renderSideBySide": false,
    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.maxComputationTime": 0,
    "search.searchOnTypeDebouncePeriod": 200,

    // ——— Files & associations ———
    "files.associations": {
        "*.css": "tailwindcss",
        ".env*": "properties",
        "*.json5": "jsonc",
        "config": "shellscript",
        "*.toml": "toml"
    },
    "files.defaultLanguage": "${activeEditorLanguage}",

    // ——— Terminal ———
    "terminal.integrated.defaultProfile.osx": "fish",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.minimumContrastRatio": 5,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.profiles.osx": {
        "fish": {
            "path": "fish",
            "args": ["-l"]
        },
        "bash": {
            "path": "bash",
            "args": ["-l"],
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh",
            "args": ["-l"]
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.shellIntegration.environmentReporting": true,
    "terminal.integrated.shellIntegration.showCommandGuide": false,
    "terminal.integrated.enableKittyKeyboardProtocol": false,
    "terminal.integrated.environmentChangesRelaunch": true,

    // ——— Git & GitHub ———
    "git.path": "/opt/homebrew/bin/git",
    "git.branchProtection": ["main"],
    "git.openRepositoryInParentFolders": "always",
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": true,
    "git.enableSmartCommit": true,
    "git.autoRepositoryDetection": true,
    "git.terminalAuthentication": false,
    "git.terminalGitEditor": false,

    // ——— Language: TypeScript / JavaScript ———
    "js/ts.tsdk.path": "./node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "js/ts.suggest.completeFunctionCalls": true,
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "js/ts.preferences.includePackageJsonAutoImports": "on",
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.tsserver.web.typeAcquisition.enabled": true,
    "js/ts.tsserver.web.projectWideIntellisense.enabled": true,
    "js/ts.suggest.autoImports": true,
    "js/ts.inlayHints.parameterNames.suppressWhenArgumentMatchesName": false,
    "js/ts.inlayHints.variableTypes.suppressWhenTypeMatchesName": false,

    // ——— Tailwind CSS ———
    "tailwindCSS.files.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/.hg/**",
        "**/.svn/**",
        "**/.next/**"
    ],
    "tailwindCSS.rootFontSize": 15,

    // ——— JSON ———
    "json.schemaDownload.enable": true,
    "json.validate.enable": true,
    "json.schemas": [
        {
            "fileMatch": ["bun.lock"],
            "schema": { "allowTrailingCommas": true }
        }
    ],

    // ——— Misc ———
    "versionlens.suggestions.showOnStartup": true,
    "biome.requireConfiguration": true,
    "markdown.preview.fontSize": 13,
    "window.autoDetectColorScheme": false,
    "openInExternalApp.openMapper": [
        {
            "extensionName": "png",
            "apps": "photopea"
        },
        {
            "extensionName": "jpeg",
            "apps": "photopea"
        },
        {
            "extensionName": "jpg",
            "apps": "photopea"
        },
        {
            "extensionName": "svg",
            "apps": "photopea"
        }
    ],
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://biomejs.dev": true
    },
    "kiroAgent.trust.defaultScope": "user",
    "security.workspace.trust.untrustedFiles": "open"
}
