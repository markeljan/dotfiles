# This is the configuration file for Ghostty.

# Keybindings
keybind = cmd+n=new_tab
keybind = cmd+shift+n=new_window
# cmd+s write file vim
keybind = super+s=text:\x1b:w\n
keybind = super+s=text:\x1b:x\n
# SSH
shell-integration = detect
shell-integration-features = ssh-env,ssh-terminfo,sudo,no-cursor

# Appearance
background-opacity = 0.8
background-blur = 20
background = "#000000"
background-image = {{ .chezmoi.homeDir }}/.config/ghostty/backgrounds/tahoe-day.jpg
background-image-opacity = 0.25
background-image-position = center
background-image-fit = cover
background-image-repeat = false

# typography
font-thicken = true
font-thicken-strength = 1
adjust-cell-height = 1

theme = dark modern
bold-color = bright
window-colorspace = display-p3
unfocused-split-opacity = 1
cursor-style = block
cursor-style-blink = true
font-size = 13

macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
macos-non-native-fullscreen = true
fullscreen = non-native

window-padding-balance = true
window-padding-x = 4
window-padding-y = 2
window-padding-color = extend-always
window-new-tab-position = end
window-save-state = never
quit-after-last-window-closed = false
