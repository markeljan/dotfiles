{{ $bootstrap := get . "bootstrap" | default dict -}}
# Shared environment, functions, and aliases for zsh and bash.

if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ ! -w "$XDG_RUNTIME_DIR" ]; then
  unset XDG_RUNTIME_DIR
fi

path_prepend() {
  case ":${PATH:-}:" in
    *":$1:"*) ;;
    *) PATH="$1${PATH:+:$PATH}"; export PATH ;;
  esac
}

# macOS defaults to 256 open files, which is too low for concurrent skill/plugin loading.
if [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
  dotfiles_nofile_soft_limit="$(ulimit -Sn 2>/dev/null || true)"
  if [ -n "$dotfiles_nofile_soft_limit" ] \
    && [ "$dotfiles_nofile_soft_limit" != "unlimited" ] \
    && [ "$dotfiles_nofile_soft_limit" -lt 65536 ] 2>/dev/null; then
    ulimit -S -n 65536 2>/dev/null || true
  fi
  unset dotfiles_nofile_soft_limit
fi

if [ -z "${HOMEBREW_PREFIX:-}" ]; then
  for brew_bin in{{ range .shell.brew_candidates }} {{ . }}{{ end }}; do
    if [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
  unset brew_bin
fi

export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_ENV_HINTS=1
{{- if get $bootstrap "install_desktop_vnc" | default false }}
export DISPLAY=:99
{{- end }}
{{- if get $bootstrap "install_openclaw" | default false }}
export NODE_COMPILE_CACHE=/var/tmp/openclaw-compile-cache
export OPENCLAW_NO_RESPAWN=1
{{- end }}
{{- range .shell.path_entries }}
path_prepend "$HOME/{{ . }}"
{{- end }}

# Remote hosts usually lack Ghostty's terminfo.
if [ "${TERM:-}" = "xterm-ghostty" ]; then
  if [ -n "${SSH_CONNECTION:-}" ] || ! infocmp xterm-ghostty >/dev/null 2>&1; then
    export TERM=xterm-256color
    unset TERMINFO
  fi
fi

mkcd() {
  mkdir -p -- "$1" && cd -- "$1"
}

unalias gc 2>/dev/null || true
gc() {
  git commit -m "${*:-yolo}"
}

{{- range .shell.aliases }}
alias {{ .name }}='{{ .expansion }}'
{{- end }}
