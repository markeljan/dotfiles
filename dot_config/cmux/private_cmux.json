{
  "$schema" : "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion" : 1,
  "shortcuts" : {
    "bindings" : {
      "closeTab" : "cmd+w",
      "newSurface" : "cmd+n",
      "newTab" : {
        "first" : {
          "command" : true,
          "control" : false,
          "key" : "=",
          "keyCode" : 24,
          "option" : false,
          "shift" : true
        }
      },
      "newWindow" : {
        "first" : {
          "command" : true,
          "control" : false,
          "key" : "n",
          "keyCode" : 45,
          "option" : false,
          "shift" : true
        }
      },
      "openBrowser" : "cmd+t",
      "selectSurfaceByNumber" : "cmd+1",
      "selectWorkspaceByNumber" : "unbound"
    }
  }
}